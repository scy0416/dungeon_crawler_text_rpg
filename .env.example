# PostgreSQL 슈퍼유저 (init 스크립트 전용)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# 서비스별 DB 계정 비밀번호 (학습용 기본값)
AUTH_DB_PASSWORD=auth_pw
CHARACTER_DB_PASSWORD=character_pw
DUNGEON_DB_PASSWORD=dungeon_pw
QUEST_DB_PASSWORD=quest_pw
NOTIFICATION_DB_PASSWORD=notification_pw

# JWT 서명 키 (auth-service만 보유)
JWT_SECRET=dev-secret-change-me
